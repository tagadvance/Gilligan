{
	"name" : "tagadvance/gilligan",
	"description" : "A collection of general-purpose PHP utilities in the spirit of Apache Commons and Guava.",
	"type" : "library",
	"keywords": ["utilities", "commons", "collections", "io", "session", "proxy"],
	"license" : "MIT",
	"authors" : [{
			"name" : "Tag",
			"email" : "tagadvance+gilligan@gmail.com"
		}
	],
	"require" : {
		"php" : "^8.4",
		"ext-apcu": "*",
		"ext-bcmath": "*",
		"ext-SPL": "*"
	},
	"require-dev" : {
		"phpunit/phpunit" : "^13.3",
		"phpstan/phpstan": "^2.2",
		"friendsofphp/php-cs-fixer": "^3.95"
	},
	"autoload" : {
		"psr-4" : {
			"tagadvance\\" : "src/tagadvance/"
		}
	}
}
